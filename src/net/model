class TemporalAttention(nn.Module):
    """简单的时间注意力池化。"""

    def __init__(self, channels, reduction=8):
        super().__init__()
        self.fc1 = nn.Linear(channels, channels // reduction)
        self.fc2 = nn.Linear(channels // reduction, 1)

    def forward(self, x):
        # x: [B, T, C]
        attn = gelu(self.fc1(x))
        attn = self.fc2(attn)
        weights = torch.softmax(attn, dim=1)
        return (x * weights).sum(dim=1)



class CNNEncoder(nn.Module):
    """单分支 CNN 编码器：将 2D 频谱图映射为固定维度特征向量。

    供 DualBranchCNN 内部复用，也可独立使用。
    """

    def __init__(self, in_channels, out_dim=64, base_filters=32,
                 dropblock_p=0.15, dropblock_block_size=6):
        super().__init__()
        self.conv1 = nn.Conv2d(1, base_filters, kernel_size=3, padding=1)
        self.bn1 = nn.BatchNorm2d(base_filters)
        self.pool1 = nn.MaxPool2d(2)

        self.conv2 = nn.Conv2d(base_filters, base_filters * 2, kernel_size=3, padding=1)
        self.bn2 = nn.BatchNorm2d(base_filters * 2)
        self.pool2 = nn.MaxPool2d(2)

        self.conv3 = nn.Conv2d(base_filters * 2, out_dim, kernel_size=3, padding=1)
        self.bn3 = nn.BatchNorm2d(out_dim)

        self.dropout = DropBlock2D(dropblock_p, dropblock_block_size)
        self.gap = nn.AdaptiveAvgPool2d((1, 1))

    def forward(self, x):
        # x: [B, 1, C, T]
        x = self.pool1(self.bn1(gelu(self.conv1(x))))
        x = self.pool2(self.bn2(gelu(self.conv2(x))))
        x = self.bn3(gelu(self.conv3(x)))
        x = self.dropout(x)
        x = self.gap(x)
        return x.view(x.size(0), -1)


class DualBranchCNN(nn.Module):
    """双分支 CNN：mel 频谱和 MFCC 各用一个编码器，语义层融合后分类。

    输入 x 为拼接后的特征 [B, mel_channels + mfcc_channels, T]：
      - 前 mel_channels 行 → MelEncoder
      - 后 mfcc_channels 行 → MFCCEncoder
    两个分支独立编码，特征向量拼接后送入全连接层。
    """

    def __init__(self, num_classes=8, mel_channels=128, mfcc_channels=126,
                 feat_dim=64, dropblock_p=0.1):
        super().__init__()
        self.name = 'dual_cnn'
        self.mel_channels = mel_channels

        # mel 分支用较小 base_filters（mel 只有 64 通道，信息密度低）
        self.mel_enc = CNNEncoder(mel_channels, out_dim=feat_dim,
                                  base_filters=32, dropblock_p=dropblock_p)
        # MFCC 分支用较大 base_filters（126 通道，含 Δ/Δ²）
        self.mfcc_enc = CNNEncoder(mfcc_channels, out_dim=feat_dim,
                                   base_filters=32, dropblock_p=dropblock_p)


    def forward(self, x):
        # x: [B, 190, T]
        mel = x[:, :self.mel_channels, :].unsqueeze(1)          # [B, 1, 64, T]
        mfcc = x[:, self.mel_channels:, :].unsqueeze(1)         # [B, 1, 126, T]

        feat_mel = self.mel_enc(mel)    # [B, feat_dim]
        feat_mfcc = self.mfcc_enc(mfcc)  # [B, feat_dim]

        feature = torch.cat([feat_mel, feat_mfcc], dim=1)      # [B, 2*feat_dim]
        return feature


class DualBranchCNNSE(nn.Module):
    """双分支 CNN + SE 注意力：与 DualBranchCNN 结构相同，分支内加入 SE 模块。"""

    def __init__(self, num_classes=8, mel_channels=128, mfcc_channels=126,
                 feat_dim=64, dropblock_p=0.1, se_reduction=16):
        super().__init__()
        self.name = 'dual_cnn_se'
        self.mel_channels = mel_channels

        self.mel_enc = _CNNEncoderSE(mel_channels, out_dim=feat_dim,
                                     base_filters=32, dropblock_p=dropblock_p,
                                     se_reduction=se_reduction)
        self.mfcc_enc = _CNNEncoderSE(mfcc_channels, out_dim=feat_dim,
                                      base_filters=32, dropblock_p=dropblock_p,
                                      se_reduction=se_reduction)


    def forward(self, x):
        mel = x[:, :self.mel_channels, :].unsqueeze(1)
        mfcc = x[:, self.mel_channels:, :].unsqueeze(1)

        feat_mel = self.mel_enc(mel)
        feat_mfcc = self.mfcc_enc(mfcc)

        feature = torch.cat([feat_mel, feat_mfcc], dim=1)
        return feature


class _CNNEncoderSE(nn.Module):
    """带 SE 注意力的单分支 CNN 编码器（DualBranchCNNSE 内部使用）。"""

    def __init__(self, in_channels, out_dim=64, base_filters=32,
                 dropblock_p=0.1, dropblock_block_size=5, se_reduction=16):
        super().__init__()
        self.conv1 = nn.Conv2d(1, base_filters, kernel_size=3, padding=1)
        self.se1 = SEBlock(base_filters, reduction=se_reduction)
        self.bn1 = nn.BatchNorm2d(base_filters)
        self.pool1 = nn.MaxPool2d(2)

        self.conv2 = nn.Conv2d(base_filters, base_filters * 2, kernel_size=3, padding=1)
        self.se2 = SEBlock(base_filters * 2, reduction=se_reduction)
        self.bn2 = nn.BatchNorm2d(base_filters * 2)
        self.pool2 = nn.MaxPool2d(2)

        self.conv3 = nn.Conv2d(base_filters * 2, out_dim, kernel_size=3, padding=1)
        self.se3 = SEBlock(out_dim, reduction=se_reduction)
        self.bn3 = nn.BatchNorm2d(out_dim)

        self.dropout = DropBlock2D(dropblock_p, dropblock_block_size)
        self.gap = nn.AdaptiveAvgPool2d((1, 1))

    def forward(self, x):
        x = self.pool1(self.se1(self.bn1(gelu(self.conv1(x)))))
        x = self.pool2(self.se2(self.bn2(gelu(self.conv2(x)))))
        x = self.se3(self.bn3(gelu(self.conv3(x))))
        x = self.dropout(x)
        x = self.gap(x)
        return x.view(x.size(0), -1)

class DualBranchCNNCBAM(nn.Module):
    """双分支 CNN + CBAM 注意力：与 DualBranchCNN 结构相同，分支内加入 CBAM 模块。"""

    def __init__(self, num_classes=8, mel_channels=128, mfcc_channels=126,
                 feat_dim=64, dropblock_p=0.1, cbam_reduction=16, cbam_kernel=3):
        super().__init__()
        self.name = 'dual_cnn_cbam'
        self.mel_channels = mel_channels

        self.mel_enc = _CNNEncoder_CBAM(mel_channels, out_dim=feat_dim,
                                        base_filters=32, dropblock_p=dropblock_p,
                                        cbam_reduction=cbam_reduction, cbam_kernel=cbam_kernel)
        self.mfcc_enc = _CNNEncoder_CBAM(mfcc_channels, out_dim=feat_dim,
                                         base_filters=32, dropblock_p=dropblock_p,
                                         cbam_reduction=cbam_reduction, cbam_kernel=cbam_kernel)


    def forward(self, x):
        mel = x[:, :self.mel_channels, :].unsqueeze(1)
        mfcc = x[:, self.mel_channels:, :].unsqueeze(1)

        feat_mel = self.mel_enc(mel)
        feat_mfcc = self.mfcc_enc(mfcc)

        feature = torch.cat([feat_mel, feat_mfcc], dim=1)
        return feature


class _CNNEncoder_CBAM(nn.Module):
    """CNN + CBAM 注意力（通道 + 空间）"""
    def __init__(self, in_channels, out_dim=64, base_filters=32,
                 dropblock_p=0.1, dropblock_block_size=5,
                 cbam_reduction=16, cbam_kernel=7):
        super().__init__()
        self.name = 'cnn_cbam'

        self.conv1 = nn.Conv2d(1, base_filters, kernel_size=3, padding=1)
        self.cbam1 = CBAM(base_filters, reduction=cbam_reduction, kernel_size=cbam_kernel)
        self.bn1 = nn.BatchNorm2d(base_filters)
        self.pool1 = nn.MaxPool2d(2)

        self.conv2 = nn.Conv2d(base_filters, base_filters * 2, kernel_size=3, padding=1)
        self.cbam2 = CBAM(base_filters * 2, reduction=cbam_reduction, kernel_size=cbam_kernel)
        self.bn2 = nn.BatchNorm2d(base_filters * 2)
        self.pool2 = nn.MaxPool2d(2)

        self.conv3 = nn.Conv2d(base_filters * 2, out_dim, kernel_size=3, padding=1)
        self.cbam3 = CBAM(out_dim, reduction=max(cbam_reduction // 2, 2),
                         kernel_size=cbam_kernel)
        self.bn3 = nn.BatchNorm2d(out_dim)

        self.dropout = DropBlock2D(dropblock_p, dropblock_block_size)
        self.gap = nn.AdaptiveAvgPool2d((1, 1))

    def forward(self, x):
        # x: [B, 1, C, T]
        x = self.pool1(self.cbam1(self.bn1(gelu(self.conv1(x)))))
        x = self.pool2(self.cbam2(self.bn2(gelu(self.conv2(x)))))
        x = self.cbam3(self.bn3(gelu(self.conv3(x))))
        x = self.dropout(x)
        x = self.gap(x)
        return x.view(x.size(0), -1)


class DualBranchCNNCBAM2(nn.Module):
    """双分支 CNN + 改进 CBAM（残差门控 + 恒等初始化）。

    与 DualBranchCNNCBAM 结构完全相同，只是把 CBAM 换成 CBAMResidual：
    门控从恒等开始、不会把特征压灭，空间卷积默认 3×3 适配小特征图。
    """

    def __init__(self, num_classes=8, mel_channels=128, mfcc_channels=126,
                 feat_dim=64, dropblock_p=0.1, cbam_reduction=16, cbam_kernel=3):
        super().__init__()
        self.name = 'dual_cnn_cbam2'
        self.mel_channels = mel_channels

        self.mel_enc = _CNNEncoder_CBAM2(mel_channels, out_dim=feat_dim,
                                         base_filters=32, dropblock_p=dropblock_p,
                                         cbam_reduction=cbam_reduction, cbam_kernel=cbam_kernel)
        self.mfcc_enc = _CNNEncoder_CBAM2(mfcc_channels, out_dim=feat_dim,
                                          base_filters=32, dropblock_p=dropblock_p,
                                          cbam_reduction=cbam_reduction, cbam_kernel=cbam_kernel)

    def forward(self, x):
        mel = x[:, :self.mel_channels, :].unsqueeze(1)
        mfcc = x[:, self.mel_channels:, :].unsqueeze(1)

        feat_mel = self.mel_enc(mel)
        feat_mfcc = self.mfcc_enc(mfcc)

        feature = torch.cat([feat_mel, feat_mfcc], dim=1)
        return feature


class _CNNEncoder_CBAM2(nn.Module):
    """CNN + 改进 CBAM 注意力（残差门控，单分支编码器）。"""

    def __init__(self, in_channels, out_dim=64, base_filters=32,
                 dropblock_p=0.1, dropblock_block_size=5,
                 cbam_reduction=16, cbam_kernel=3):
        super().__init__()
        self.name = 'cnn_cbam2'

        self.conv1 = nn.Conv2d(1, base_filters, kernel_size=3, padding=1)
        self.cbam1 = CBAMResidual(base_filters, reduction=cbam_reduction, kernel_size=cbam_kernel)
        self.bn1 = nn.BatchNorm2d(base_filters)
        self.pool1 = nn.MaxPool2d(2)

        self.conv2 = nn.Conv2d(base_filters, base_filters * 2, kernel_size=3, padding=1)
        self.cbam2 = CBAMResidual(base_filters * 2, reduction=cbam_reduction, kernel_size=cbam_kernel)
        self.bn2 = nn.BatchNorm2d(base_filters * 2)
        self.pool2 = nn.MaxPool2d(2)

        self.conv3 = nn.Conv2d(base_filters * 2, out_dim, kernel_size=3, padding=1)
        self.cbam3 = CBAMResidual(out_dim, reduction=max(cbam_reduction // 2, 2),
                                  kernel_size=cbam_kernel)
        self.bn3 = nn.BatchNorm2d(out_dim)

        self.dropout = DropBlock2D(dropblock_p, dropblock_block_size)
        self.gap = nn.AdaptiveAvgPool2d((1, 1))

    def forward(self, x):
        # x: [B, 1, C, T]
        x = self.pool1(self.cbam1(self.bn1(gelu(self.conv1(x)))))
        x = self.pool2(self.cbam2(self.bn2(gelu(self.conv2(x)))))
        x = self.cbam3(self.bn3(gelu(self.conv3(x))))
        x = self.dropout(x)
        x = self.gap(x)
   
        return x.view(x.size(0), -1)
   


class dual_lstm(nn.Module):
    """双分支 LSTM：mel 频谱和 MFCC 各用一个 LSTM，语义层融合后分类。

    输入 x 为拼接后的特征 [B, mel_channels + mfcc_channels, T]：
      - 前 mel_channels 行 → MelLSTM
      - 后 mfcc_channels 行 → MFCCLSTM
    """
    def __init__(self, input_size=190, num_classes=8, mel_channels=128, mfcc_channels=126,
                 hidden_size=128, num_layers=1, lstm_dropout=0.2):
        super().__init__()
        self.name = 'dual_lstm'
        self.mel_channels = mel_channels

        self.mel_lstm = LSTM(input_size=mel_channels, num_classes=num_classes,
                             hidden_size=hidden_size, num_layers=num_layers,
                             lstm_dropout=lstm_dropout)
        self.mfcc_lstm = LSTM(input_size=mfcc_channels, num_classes=num_classes,
                              hidden_size=hidden_size, num_layers=num_layers,
                              lstm_dropout=lstm_dropout)    

    def forward(self, x):
        mel = x[:, :self.mel_channels, :]
        mfcc = x[:, self.mel_channels:, :]

        feat_mel = self.mel_lstm(mel)
        feat_mfcc = self.mfcc_lstm(mfcc)

        feature = torch.cat([feat_mel, feat_mfcc], dim=1)
        return feature

